{
  "min-format/0byte-file": (
    // Bet it's the simplest you can get right?
    content: File(None),
  ),
  "min-format/only-content": (
    content: File(b"Use byte strings for raw text content"),
  ),
  "min-format/only-base64": (
    // Use normal string for base64-encoded contents
    content: File("QmFzZTY0IGFsc28gc3VwcG9ydGVkIQ=="),
  ),

  "min-format/optin-mode": (
    content: File(None),
    mode: 0o600, // You can use decimal if you hate your future self enough
  ),

  "min-format/optin-owner": (
    content: File(b"Can include owner, group, or both"),
    owner: "root",
  ),
  "min-format/optin-group": (
    content: File(b"You can also directly specify UID and/or GID"),
    group: 0,
  ),
  "min-format/optin-both": (
    content: File(b"Or even better, both name and ID!"),
    owner: ("vscode", 1000),
    group: ("wheel", 1),
  ),

  "min-format/directory": (
    content: Directory, // Please see /src/format/mod.rs for more content types
  ),

  // Here's the fuller picture i guess

  "full-format/0byte-file": (
    content: File(None), // EntryData::File (untagged variant)
    mode: None, // Option<u16>
    owner: None, // untagged enum Option<Identity>
    group: None,
  ),
  "full-format/all-fields": ( // Name of Struct
    content: File(b"contents"), // = EntryData::File(Some(String::from("contents")))
    mode: 0o644,
    owner: "root", // = Some(Identity::Name(String::from("root")))
    group: ("wheel", 1), // = Some(Identity::Pair(Some(String::from("wheel"), 0u32)))
  ),
  "is/it/too/verbose?": TarEntry(
    content: File(b"verbose string"),
    mode: Some(0o664),
    owner: Some(0),
    group: Some("everyone"),
  )
}
